# Copy to .env (or set in your host's dashboard). Never commit real values.
PORT=3000
NODE_ENV=production
SITE_URL=https://kitchentechindia.com
TRUST_PROXY=1                      # set when running behind Nginx / Render / Hostinger proxy

# Product: the site shows "price coming" and routes buyers to WhatsApp until AANCH_PRICE is set
AANCH_PRICE=                       # selling price in rupees, e.g. 2499
AANCH_MRP=                         # MRP for the strike-through, e.g. 3499
AANCH_PREPAID_DISCOUNT=0           # rupees off per unit when paying online (COD-to-prepaid nudge)

# Owner dashboard at /admin (16+ random characters)
ADMIN_TOKEN=

# Razorpay (UPI, cards, netbanking). Online payment stays switched off until both keys are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=           # webhook URL: https://<domain>/api/payments/razorpay/webhook

# Meta Pixel + Conversions API (ad tracking for Facebook / Instagram campaigns)
META_PIXEL_ID=
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=

GA4_ID=                            # Google Analytics 4 measurement id, e.g. G-XXXXXXX

# Optional: POST every new order / lead as JSON to Make, Zapier, n8n, Slack, a Google Sheet script...
NOTIFY_WEBHOOK_URL=

DB_PATH=./data/kitchentech.db      # put this on a persistent disk in production
